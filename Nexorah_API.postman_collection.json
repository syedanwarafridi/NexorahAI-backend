            "url": {
              "raw": "{{base_url}}/study-vault/flashcards/",
              "host": ["{{base_url}}"],
              "path": ["study-vault", "flashcards", ""],
              "query": [{ "key": "topic", "value": "mathematics", "disabled": true, "description": "Optional topic filter" }]
            }
          }
        },
        {
          "name": "List Flashcards (Filtered by Topic)",
          "request": {
