            "body": {
              "mode": "raw",
              "raw": "{\n  \"daily_goal_minutes\": 90,\n  \"weekly_goal_hours\": 10\n}"
            },
            "url": { "raw": "{{base_url}}/study-planner/plan/", "host": ["{{base_url}}"], "path": ["study-planner", "plan", ""] }
          }
        },
        {
          "name": "List Study Sessions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/study-planner/sessions/", "host": ["{{base_url}}"], "path": ["study-planner", "sessions", ""] }
          }
        },
        {
          "name": "Create Study Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-05-13\",\n  \"duration_minutes\": 90,\n  \"notes\": \"Reviewed chapters 1 to 3\"\n}"
            },
            "url": { "raw": "{{base_url}}/study-planner/sessions/", "host": ["{{base_url}}"], "path": ["study-planner", "sessions", ""] }
          }
        },
        {
          "name": "Get Planner Stats",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/study-planner/stats/", "host": ["{{base_url}}"], "path": ["study-planner", "stats", ""] }
          }
        },
        {
          "name": "List Calendar Events",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/study-planner/calendar/", "host": ["{{base_url}}"], "path": ["study-planner", "calendar", ""] }
          }
        },
        {
          "name": "Create Calendar Event",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Math Review Session\",\n  \"date\": \"2026-05-20\",\n  \"color\": \"blue\",\n  \"reminder_minutes_before\": 15,\n  \"recurrence\": \"weekly\"\n}",
              "options": {
                "raw": {
                  "language": "json",
                  "_comment": "color choices: 'green', 'red', 'blue', 'orange'. recurrence is optional."
                }
              }
            },
            "url": { "raw": "{{base_url}}/study-planner/calendar/", "host": ["{{base_url}}"], "path": ["study-planner", "calendar", ""] }
          }
        },
        {
          "name": "Update Calendar Event",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Event Title\",\n  \"color\": \"green\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/study-planner/calendar/:event_id/",
              "host": ["{{base_url}}"],
              "path": ["study-planner", "calendar", ":event_id", ""],
              "variable": [{ "key": "event_id", "value": "1", "description": "Calendar event ID" }]
            }
          }
        },
        {
          "name": "Delete Calendar Event",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/study-planner/calendar/:event_id/",
              "host": ["{{base_url}}"],
              "path": ["study-planner", "calendar", ":event_id", ""],
              "variable": [{ "key": "event_id", "value": "1", "description": "Calendar event ID" }]
            }
          }
        }
      ]
    },
