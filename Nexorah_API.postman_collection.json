        {
          "name": "List Articles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/study-vault/articles/",
              "host": ["{{base_url}}"],
              "path": ["study-vault", "articles", ""],
              "query": [{ "key": "topic", "value": "mathematics", "disabled": true }]
            }
          }
        },
        {
          "name": "Get Article Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/study-vault/articles/:pk/",
              "host": ["{{base_url}}"],
              "path": ["study-vault", "articles", ":pk", ""],
