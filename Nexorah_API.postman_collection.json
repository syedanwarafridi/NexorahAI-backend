            }
          }
        },
        {
          "name": "Get Article Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/study-vault/articles/:pk/",
              "host": ["{{base_url}}"],
              "path": ["study-vault", "articles", ":pk", ""],
              "variable": [{ "key": "pk", "value": "1", "description": "Article ID" }]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/dashboard/stats/", "host": ["{{base_url}}"], "path": ["dashboard", "stats", ""] }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Get Subscription Plans",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/payments/plans/", "host": ["{{base_url}}"], "path": ["payments", "plans", ""] }
          }
        },
        {
          "name": "Create Checkout Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.checkout_url) console.log('Open this URL to pay:', json.checkout_url);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan_id\": 1,\n  \"success_url\": \"http://localhost:3000/payment/success\"\n}",
              "options": {
                "raw": {
                  "language": "json",
                  "_comment": "plan_id 1 = 1 Month ($29), plan_id 2 = 3 Months ($69). Returns checkout_url — redirect user to this URL to complete payment on Lemon Squeezy."
                }
              }
            },
            "url": { "raw": "{{base_url}}/payments/checkout/", "host": ["{{base_url}}"], "path": ["payments", "checkout", ""] }
          }
        },
        {
          "name": "Get Subscription Status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/payments/status/", "host": ["{{base_url}}"], "path": ["payments", "status", ""] }
          }
        },
        {
          "name": "Verify Payment (after Lemon Squeezy redirect)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/payments/verify/?order_id={{ls_order_id}}",
              "host": ["{{base_url}}"],
              "path": ["payments", "verify", ""],
              "query": [{ "key": "order_id", "value": "{{ls_order_id}}", "description": "Lemon Squeezy order ID from the redirect" }]
            }
          }
        }
      ]
    },
    {
      "name": "Token",
      "item": [
        {
          "name": "Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access) pm.collectionVariables.set('access_token', json.access);",
                  "if (json.refresh) pm.collectionVariables.set('refresh_token', json.refresh);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/token/refresh/", "host": ["{{base_url}}"], "path": ["token", "refresh", ""] }
          }
        }
      ]
    }
  ]
}
