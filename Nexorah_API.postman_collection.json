              "host": ["{{base_url}}"],
              "path": ["study-vault", "flashcards", ""],
              "query": [{ "key": "topic", "value": "mathematics" }]
            }
          }
        },
        {
          "name": "List Keywords",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/study-vault/keywords/",
              "host": ["{{base_url}}"],
              "path": ["study-vault", "keywords", ""],
              "query": [{ "key": "topic", "value": "mathematics", "disabled": true }]
            }
          }
        },
